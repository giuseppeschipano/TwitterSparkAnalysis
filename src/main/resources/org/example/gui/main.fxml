<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.Region?>

<BorderPane prefHeight="750.0" prefWidth="1100.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.gui.MainController">

    <top>
        <VBox spacing="10.0" style="-fx-background-color: linear-gradient(to right, #1a2a6c, #b21f1f, #fdbb2d); -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 10, 0, 0, 0);" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox>
                            <children>
                                <Label text="Twitter Spark Analysis" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="28.0" />
                                    </font>
                                </Label>
                                <Label text="USA 2020 Presidential Election Dashboard" textFill="#eeeeee">
                                    <font>
                                        <Font name="System Italic" size="13.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="15.0" style="-fx-background-color: rgba(255,255,255,0.15); -fx-padding: 10; -fx-background-radius: 10;">
                            <children>
                                <Label text="Query:" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <ComboBox fx:id="querySelector" prefWidth="280.0" promptText="Seleziona un'analisi..."
                                          style="-fx-background-color: white; -fx-background-radius: 5; -fx-font-size: 13;" />
                                <Button fx:id="executeButton" mnemonicParsing="false"
                                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);"
                                        text="AVVIA ANALISI">
                                    <padding>
                                        <Insets bottom="10.0" left="25.0" right="25.0" top="10.0" />
                                    </padding>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <VBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="25.0" right="25.0" top="25.0" />
            </padding>
            <children>
                <TabPane style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 0); -fx-tab-min-width: 150;"
                         tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <tabs>
                        <Tab text="📊 Tabella Risultati">
                            <content>
                                <VBox spacing="10" style="-fx-padding: 15;">
                                    <TableView fx:id="table" prefHeight="400" prefWidth="600"
                                               style="-fx-background-radius: 5; -fx-border-color: #dfe6e9; -fx-border-radius: 5;">
                                        <placeholder>
                                            <Label text="In attesa di dati... seleziona una query e clicca su Esegui." textFill="#636e72" />
                                        </placeholder>
                                    </TableView>
                                </VBox>
                            </content>
                        </Tab>
                        <Tab text="📈 Grafico a Barre">
                            <content>
                                <BarChart fx:id="barChart" animated="true" style="-fx-padding: 15;">
                                    <xAxis>
                                        <CategoryAxis fx:id="xAxis" label="Categorie" side="BOTTOM" />
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis fx:id="yAxis" label="Valori" side="LEFT" />
                                    </yAxis>
                                </BarChart>
                            </content>
                        </Tab>
                        <Tab text="🍕 Grafico a Torta">
                            <content>
                                <PieChart fx:id="pieChart" clockwise="true" labelsVisible="true" style="-fx-padding: 15;" />
                            </content>
                        </Tab>
                        <Tab text="📉 Line Chart">
                            <content>
                                <LineChart fx:id="lineChart" style="-fx-padding: 15;">
                                    <xAxis>
                                        <CategoryAxis fx:id="lineXAxis" label="Data" />
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis fx:id="lineYAxis" label="Frequenza" />
                                    </yAxis>
                                </LineChart>
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>
            </children>
        </VBox>
    </center>

    <bottom>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="5.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 14;" text="System Status &amp; Logs" />
                        <Region style="-fx-background-color: #2ecc71; -fx-min-width: 10; -fx-min-height: 10; -fx-max-width: 10; -fx-max-height: 10; -fx-background-radius: 10;" />
                    </children>
                </HBox>
                <TextArea fx:id="logArea" editable="false" prefHeight="140.0"
                          style="-fx-control-inner-background: #1e272e; -fx-text-fill: #00d8d6; -fx-font-family: 'Consolas', 'Courier New'; -fx-font-size: 12; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #34495e; -fx-border-width: 2;"
                          wrapText="true" />
            </children>
        </VBox>
    </bottom>
</BorderPane>